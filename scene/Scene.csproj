<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="RuntimeIdentifier">

  <!-- Brickyard P0 (GuitarAlchemist/gaia#260): the robot's scene, drawn with Vulkan through BRUTAL's bindings as
       ga-brutal's HallSlice is, with the same exact package versions and a lock file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The watch compiler must resolve the same debug image as the Windows runner. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>scene</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="[4.17.0]" />
    <ProjectReference Include="..\module-contracts\SceneModules.Contracts.csproj" />
    <!-- The hall's gallery as Lego blocks, in F# (gallery/Blocks.fs, on lego/, a copy of ga's; lego/ORIGIN.md). -->
    <ProjectReference Include="..\gallery\Gallery.fsproj" />
    <PackageReference Include="Ahwoo.Brutal.Core" Version="[2026.10.1]" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" Version="[2026.10.4]" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan" Version="[2026.10.2]" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" Version="[2026.10.2]" />
    <PackageReference Include="Ahwoo.Brutal.ShaderC" Version="[2026.10.2]" />
  </ItemGroup>

  <ItemGroup>
    <!-- BRUTAL's logo and notice, unaltered, from github.com/ahwootech/brutal-branding at 5d38373 (Splash.cs). -->
    <None Include="brand\LOGO_BRUTAL_WHT.png;brand\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The gallery's content as the learn site had it (HallGallery), when %LOCALAPPDATA%\delta has none of its own. -->
    <None Include="..\gallery\gallery.json" Link="gallery.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The release notes the window shows when its version is clicked (Notes.cs). -->
    <EmbeddedResource Include="..\docs\releases\*.md" LogicalName="releases/%(Filename)%(Extension)" />
    <!-- The arcade film's pilot, which plays PARSEC by its keys (ArcadeFilm). -->
    <EmbeddedResource Include="ParsecPilot.js" LogicalName="ParsecPilot.js" />
  </ItemGroup>

</Project>
