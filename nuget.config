<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org only. Exact versions already in the global packages folder are used without downloading, and
     packages.lock.json pins every package's content hash. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
